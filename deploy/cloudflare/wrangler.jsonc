{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ksj-route-search",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // 画面（SvelteKit の adapter-static 出力）。/api と /tiles だけ Worker のコードを通し、他は Assets が直接返す。
  // 道路タイル（200 MB）は 1 ファイル 25 MiB の上限を超えるので web/static/.assetsignore で外し、R2 から返す
  "assets": {
    "directory": "../../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tiles/*"]
  },

  // roads_nationwide.pmtiles を置くバケット。作成とアップロードは README の手順
  "r2_buckets": [{ "binding": "TILES", "bucket_name": "ksj-route-tiles" }],

  // 一般公開なので、重い探索（/reachability /route）を IP ごとに絞る。1 台しかないので連打で他の人が待たされる。
  // 同じ IP の後ろに大勢いる（社内・会場の Wi-Fi）と共有になるので、人の操作では当たらない程度に緩めにしてある
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],

  // FastAPI をそのままコンテナで動かす。グラフ parquet はイメージに焼き込み（deploy-cloudflare.md 4-2）
  "containers": [
    {
      "class_name": "RouteContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 1/2 vCPU・4 GiB・8 GB disk。常駐 2.2 GiB・起動ピーク 3.2 GiB（ローカル実測 2026-09-26）
      "instance_type": "standard-1",
      // グラフはメモリ上にあり、1 台で費用の上限を決める（deploy-cloudflare.md 7 章）
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROUTE_CONTAINER", "class_name": "RouteContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RouteContainer"] }]
}
