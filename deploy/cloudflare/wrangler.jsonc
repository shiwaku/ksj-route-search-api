{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ksj-route-search",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // 公開の一時停止は false にして npx wrangler deploy（Worker・コンテナのイメージ・R2 のタイルは残るので、true に戻せば同じ URL で再開）。
  // 2026-09-27 に一度止めて同日に再開した。止めている間はリクエストが来ないのでコンテナも起きない
  // 2026-09-28 から社内限定: workers.dev の前に Cloudflare Access（@mierune.co.jp だけ通す）。設定はダッシュボード側で、ここには出てこない（README「社内限定の公開」）
  "workers_dev": true,
  "preview_urls": false,

  // 画面（SvelteKit の adapter-static 出力）。/api と /tiles だけ Worker のコードを通し、他は Assets が直接返す。
  // 道路タイル（200 MB）は 1 ファイル 25 MiB の上限を超えるので web/static/.assetsignore で外し、R2 から返す
  "assets": {
    "directory": "../../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tiles/*"]
  },

  // 道路タイルは共有バケット shi-works（shi-works.com で公開中）の pmtiles/ksj-route-search/ に置く。
  // キーは src/worker.ts の TILE_KEY、アップロードとデータ更新は README の手順
  "r2_buckets": [{ "binding": "TILES", "bucket_name": "shi-works" }],

  // 一般公開なので、重い探索（/reachability /route）の回数を絞る。1 台しかないので連打で他の人が待たされる。
  // API_LIMITER は端末ごと（IP＋画面が送る X-Client-Id）、IP_LIMITER は IP 全体。会場や社内の Wi-Fi は
  // 大勢で 1 つの IP を共有するので、IP 全体の枠は数十人が触っても当たらない大きさにしてある（issue #25）。
  // 人の操作は 1 タップ 1 回なので、1 人 10 秒 20 回・1 IP 10 秒 300 回（30 回/秒）はどちらも普通は当たらない。
  // ⚠️ 大まかにしか効かない（実機 2026-09-26）: period 60・limit 120 は 300 回連打しても 429 にならず、
  // period 10・limit 10 は逐次 13 回目で 429。並列で投げると上限を超えても通ることがある。
  // 落ちない保証はコンテナ側の同時計算 2 本（api/core.py）で持ち、これは歯止め程度に考える
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 10 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 10 } }
  ],

  // FastAPI をそのままコンテナで動かす。グラフ parquet はイメージに焼き込み（deploy-cloudflare.md 4-2）
  "containers": [
    {
      "class_name": "RouteContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 1/2 vCPU・4 GiB・8 GB disk。常駐 2.2 GiB・起動ピーク 3.2 GiB（ローカル実測 2026-09-26）
      "instance_type": "standard-1",
      // グラフはメモリ上にあり、1 台で費用の上限を決める（deploy-cloudflare.md 7 章）。
      // 台数を増やすときは vars の CONTAINER_COUNT と一緒に上げる（CONTAINER_COUNT ≦ max_instances）
      "max_instances": 1
    }
  ],
  // CONTAINER_COUNT: /api を振り分ける台数（issue #26）。SLEEP_AFTER: 最後のリクエストから寝るまで（issue #27）。
  // FOSS4G の当日だけ上げ、終わったら 1・10m に戻す（README「当日の構成」）
  "vars": {
    "CONTAINER_COUNT": "1",
    "SLEEP_AFTER": "10m"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROUTE_CONTAINER", "class_name": "RouteContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RouteContainer"] }]
}
